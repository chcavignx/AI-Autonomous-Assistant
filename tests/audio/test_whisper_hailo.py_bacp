"""Unit tests for WhisperHailoStreamer."""

from __future__ import annotations

import sys
import types

# Ensure mocks are injected before importing
from importlib.machinery import ModuleSpec
from unittest.mock import MagicMock, patch

hailo_mock = sys.modules.get("hailo_platform")
if hailo_mock is None or isinstance(hailo_mock, MagicMock) or not hasattr(hailo_mock, "HEF"):
    hailo_mock = types.ModuleType("hailo_platform")
    hailo_mock.__spec__ = ModuleSpec("hailo_platform", None)  # type: ignore
    hailo_mock.HailoStreamInterface = MagicMock()
    hailo_mock.ConfigureParams = MagicMock()
    hailo_mock.InputVStreamParams = MagicMock()
    hailo_mock.OutputVStreamParams = MagicMock()
    hailo_mock.InferVStreams = MagicMock()
    hailo_mock.HEF = MagicMock()
    hailo_mock.VDevice = MagicMock()

    class MockFormatType:
        FLOAT32 = 0
        UINT8 = 1

    hailo_mock.FormatType = MockFormatType
    sys.modules["hailo_platform"] = hailo_mock

sd_mock = types.ModuleType("sounddevice")
sd_mock.__spec__ = ModuleSpec("sounddevice", None)  # type: ignore
sys.modules["sounddevice"] = sd_mock

import unittest

import numpy as np
from src.audio.whisper_hailo import WhisperHailoStreamer


class TestWhisperHailoStreamer(unittest.TestCase):
    """Test suite for WhisperHailoStreamer."""

    @patch("src.vision.hailo_backend.HEF")
    @patch("src.vision.hailo_backend.VDevice")
    def test_init(self, mock_vdevice: MagicMock, mock_hef: MagicMock) -> None:
        """Test initialisation of Whisper streamer."""
        mock_hef_instance = MagicMock()
        mock_hef_instance.get_network_group_names.return_value = ["test_group"]
        mock_hef.return_value = mock_hef_instance

        streamer = WhisperHailoStreamer()
        assert streamer.sample_rate == 16000

    @patch("src.vision.hailo_backend.HEF")
    @patch("src.vision.hailo_backend.VDevice")
    @patch("src.vision.hailo_backend.InferVStreams")
    def test_transcribe_chunk_placeholder(
        self, mock_infer: MagicMock, mock_vdevice: MagicMock, mock_hef: MagicMock
    ) -> None:
        """Test transcribe chunk returning None for placeholder result."""
        mock_hef_instance = MagicMock()
        mock_hef_instance.get_network_group_names.return_value = ["test_group"]

        mock_input_info = MagicMock()
        mock_input_info.name = "input_0"
        mock_input_info.shape = (1, 16000)
        mock_hef_instance.get_input_vstream_infos.return_value = [mock_input_info]

        mock_output_info = MagicMock()
        mock_output_info.name = "output_0"
        mock_output_info.shape = (1, 100)
        mock_hef_instance.get_output_vstream_infos.return_value = [mock_output_info]

        mock_hef.return_value = mock_hef_instance

        mock_infer_instance = MagicMock()
        mock_infer_instance.infer.return_value = {"output_0": np.zeros((1, 100))}
        mock_infer.return_value = mock_infer_instance

        streamer = WhisperHailoStreamer()
        dummy_audio = np.zeros(16000, dtype=np.float32)
        res = streamer.transcribe_chunk(dummy_audio)

        assert res is None
